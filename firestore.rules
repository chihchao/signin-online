rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Roster/attendance doc ids and studentEmail fields are always
    // lowercased (see rosterService/attendanceService), but a Google ID
    // token's email claim isn't guaranteed to be, so every comparison
    // against them goes through this.
    function authEmail() {
      return request.auth.token.email.lower();
    }

    function isWhitelistedTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }

    function isCourseTeacher() {
      return isSignedIn() &&
        request.auth.token.email in resource.data.teacherEmails;
    }

    // Emails newly added to teacherEmails by this write (empty for
    // updates that don't touch teacherEmails, or that only remove
    // entries).
    function addedTeacherEmails() {
      return request.resource.data.teacherEmails.removeAll(resource.data.teacherEmails);
    }

    function isValidTeacherEmailsChange() {
      let added = addedTeacherEmails();
      return request.resource.data.teacherEmails.size() > 0 &&
        (added.size() == 0 ||
          (added.size() == 1 &&
            exists(/databases/$(database)/documents/teachers/$(added[0]))));
    }

    function isValidQrExpirySeconds() {
      return request.resource.data.qrExpirySeconds is int &&
        request.resource.data.qrExpirySeconds > 0;
    }

    // Only teacherEmails and qrExpirySeconds may change on update; the
    // rest of the course's identity is immutable once created.
    function onlyMutableFieldsChanged() {
      return request.resource.data.name == resource.data.name &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function isTeacherOfCourse(courseId) {
      return isSignedIn() &&
        request.auth.token.email in
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherEmails;
    }

    function isEnrolledStudent(courseId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/courses/$(courseId)/roster/$(authEmail()));
    }

    match /courses/{courseId} {
      allow create: if isWhitelistedTeacher() &&
        request.resource.data.teacherEmails == [request.auth.token.email] &&
        isValidQrExpirySeconds();
      allow read: if isCourseTeacher();
      allow update: if isCourseTeacher() &&
        isValidTeacherEmailsChange() &&
        isValidQrExpirySeconds() &&
        onlyMutableFieldsChanged();

      match /roster/{studentEmail} {
        allow read, write: if isTeacherOfCourse(courseId);
        // A student may check only their own membership (by path
        // segment, so this is well-defined even when no such document
        // exists) — not list or read anyone else's roster entry. Roster
        // doc ids are always lowercased (see rosterService), but
        // Google's auth token email isn't guaranteed to be, so compare
        // case-insensitively.
        allow get: if isSignedIn() && authEmail() == studentEmail;
      }
    }

    // Points a course at the session its "開始點名" flow should resume,
    // so concurrent start calls (e.g. two co-teachers) can be resolved
    // atomically in a single transaction instead of a query-then-create
    // race. See sessionsService.startOrResumeSession.
    match /activeSessions/{courseId} {
      allow read, write: if isTeacherOfCourse(courseId);
    }

    match /sessions/{sessionId} {
      allow create: if isTeacherOfCourse(request.resource.data.courseId) &&
        request.resource.data.createdBy == request.auth.token.email &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.endedAt == null;
      // Listing (querying) sessions stays teacher-only. A course's
      // teacher or an enrolled student may fetch one session by its
      // exact id — needed by the student check-in flow to read
      // endedAt/courseId. `resource != null` guards the get-of-a-
      // nonexistent-id case (a garbage/tampered check-in link) so that
      // cleanly evaluates to a deny instead of erroring on
      // resource.data being unset.
      allow list: if isTeacherOfCourse(resource.data.courseId);
      allow get: if resource != null &&
        (isTeacherOfCourse(resource.data.courseId) || isEnrolledStudent(resource.data.courseId));
      // "結束點名": only the course's teachers, only a one-way
      // null -> request.time transition (no re-ending, no un-ending,
      // no backdating), and nothing else about the session may change.
      allow update: if isTeacherOfCourse(resource.data.courseId) &&
        resource.data.endedAt == null &&
        request.resource.data.endedAt == request.time &&
        request.resource.data.courseId == resource.data.courseId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.keys().hasOnly(['courseId', 'createdBy', 'createdAt', 'endedAt']);

      match /tokens/{tokenId} {
        function sessionCourseId() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)).data.courseId;
        }

        allow create: if isTeacherOfCourse(sessionCourseId()) &&
          request.resource.data.createdAt == request.time;
        allow read: if isTeacherOfCourse(sessionCourseId());
      }
    }

    function isValidAttendanceDocId(attendanceId, data) {
      return attendanceId == data.sessionId + '_' + data.studentEmail;
    }

    // A student checking themselves in: status is always 'present', the
    // token must still be fresh, and studentEmail must be the requester.
    function isValidStudentAttendanceCreate(attendanceId) {
      let data = request.resource.data;
      let session = get(/databases/$(database)/documents/sessions/$(data.sessionId)).data;
      let course = get(/databases/$(database)/documents/courses/$(data.courseId)).data;
      let token = get(/databases/$(database)/documents/sessions/$(data.sessionId)/tokens/$(data.tokenId)).data;

      return isSignedIn() &&
        isValidAttendanceDocId(attendanceId, data) &&
        data.keys().hasOnly(['sessionId', 'courseId', 'studentEmail', 'tokenId', 'status', 'timestamp']) &&
        data.studentEmail == authEmail() &&
        data.status == 'present' &&
        data.timestamp == request.time &&
        data.courseId == session.courseId &&
        session.endedAt == null &&
        exists(/databases/$(database)/documents/courses/$(data.courseId)/roster/$(data.studentEmail)) &&
        token.createdAt > request.time - duration.value(course.qrExpirySeconds, 's');
    }

    // A teacher writing on a student's behalf. Issue #7 (batch-marking
    // absences when ending a session) only ever needs status=='absent';
    // narrowed to exactly that rather than the full status enum #8 will
    // need, so this doesn't ship write access #7 has no use for ahead
    // of #8's actual (and possibly differently-shaped, e.g. an audit
    // trail) requirements. Widen when #8 lands. timestamp still isn't
    // pinned to request.time (manual edits may backdate, per spec) but
    // must at least be a real Timestamp, not absent or malformed.
    function isValidTeacherAttendanceCreate(attendanceId) {
      let data = request.resource.data;

      return isTeacherOfCourse(data.courseId) &&
        isValidAttendanceDocId(attendanceId, data) &&
        data.keys().hasOnly(['sessionId', 'courseId', 'studentEmail', 'status', 'timestamp']) &&
        data.status == 'absent' &&
        data.timestamp is timestamp &&
        get(/databases/$(database)/documents/sessions/$(data.sessionId)).data.courseId == data.courseId &&
        exists(/databases/$(database)/documents/courses/$(data.courseId)/roster/$(data.studentEmail));
    }

    match /attendance/{attendanceId} {
      // A student may read only their own attendance records (this
      // also covers the "did I already check in" query used before
      // writing, and doubles as the seam #8's self-check page reads).
      // A course's teacher may read every attendance record for it —
      // needed to compute "who's missing" when ending a session, and
      // will back #8/#10's UI too. For `list` requests, Firestore's
      // rule provability only accepts get()-based checks like
      // isTeacherOfCourse() when every field they (transitively) read
      // from resource.data is also constrained by an equality filter
      // in the query — courseId here, always paired with a sessionId
      // filter by every caller in this codebase.
      allow read: if isSignedIn() && authEmail() == resource.data.studentEmail;
      allow read: if isTeacherOfCourse(resource.data.courseId);
      allow create: if isValidStudentAttendanceCreate(attendanceId) || isValidTeacherAttendanceCreate(attendanceId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
