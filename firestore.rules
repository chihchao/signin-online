rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Roster/attendance doc ids and studentEmail fields are always
    // lowercased (see rosterService/attendanceService), but a Google ID
    // token's email claim isn't guaranteed to be, so every comparison
    // against them goes through this.
    function authEmail() {
      return request.auth.token.email.lower();
    }

    function isWhitelistedTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }

    function isCourseTeacher() {
      return isSignedIn() &&
        request.auth.token.email in resource.data.teacherEmails;
    }

    // Emails newly added to teacherEmails by this write (empty for
    // updates that don't touch teacherEmails, or that only remove
    // entries).
    function addedTeacherEmails() {
      return request.resource.data.teacherEmails.removeAll(resource.data.teacherEmails);
    }

    function isValidTeacherEmailsChange() {
      let added = addedTeacherEmails();
      return request.resource.data.teacherEmails.size() > 0 &&
        (added.size() == 0 ||
          (added.size() == 1 &&
            exists(/databases/$(database)/documents/teachers/$(added[0]))));
    }

    function isValidQrExpirySeconds() {
      return request.resource.data.qrExpirySeconds is int &&
        request.resource.data.qrExpirySeconds > 0;
    }

    // The extra 狀態 options ("請假", "公假", ...) a teacher may pick
    // beyond the fixed system statuses present/absent (always valid —
    // see isValidAttendanceStatus — and never listed here). Defaults to
    // an empty list via .get() so a course predating this field isn't
    // rejected outright; it simply has no manual status options until
    // its teacher saves some via 課程設定.
    function isValidCustomStatuses() {
      let statuses = request.resource.data.get('customStatuses', []);
      return statuses is list &&
        statuses.size() <= 20 &&
        !('' in statuses) &&
        statuses.toSet().size() == statuses.size();
    }

    // Only teacherEmails, qrExpirySeconds and customStatuses may change
    // on update; the rest of the course's identity is immutable once
    // created.
    function onlyMutableFieldsChanged() {
      return request.resource.data.name == resource.data.name &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function isTeacherOfCourse(courseId) {
      return isSignedIn() &&
        request.auth.token.email in
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherEmails;
    }

    function isEnrolledStudent(courseId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/courses/$(courseId)/roster/$(authEmail()));
    }

    match /courses/{courseId} {
      allow create: if isWhitelistedTeacher() &&
        request.resource.data.teacherEmails == [request.auth.token.email] &&
        isValidQrExpirySeconds() &&
        isValidCustomStatuses();
      allow read: if isCourseTeacher();
      // An enrolled student may fetch (not list/browse) a course they're
      // in by its known id — needed by the self-check page (#9) to show
      // the course name next to each attendance record.
      allow get: if isEnrolledStudent(courseId);
      allow update: if isCourseTeacher() &&
        isValidTeacherEmailsChange() &&
        isValidQrExpirySeconds() &&
        isValidCustomStatuses() &&
        onlyMutableFieldsChanged();
      // 刪除課程: any of the course's teachers. deleteCourse deletes
      // this document last, after every session/token/attendance/
      // roster/activeSessions doc scoped to it — those rules all
      // re-check isTeacherOfCourse(courseId), which requires this
      // document to still exist, so deleting it first would strand
      // them unreachable by anyone.
      allow delete: if isCourseTeacher();

      match /roster/{studentEmail} {
        allow read, write: if isTeacherOfCourse(courseId);
        // A student may check only their own membership (by path
        // segment, so this is well-defined even when no such document
        // exists) — not list or read anyone else's roster entry. Roster
        // doc ids are always lowercased (see rosterService), but
        // Google's auth token email isn't guaranteed to be, so compare
        // case-insensitively.
        allow get: if isSignedIn() && authEmail() == studentEmail;
      }
    }

    // Points a course at the session its "開始點名" flow should resume,
    // so concurrent start calls (e.g. two co-teachers) can be resolved
    // atomically in a single transaction instead of a query-then-create
    // race. See sessionsService.startOrResumeSession.
    match /activeSessions/{courseId} {
      allow read, write: if isTeacherOfCourse(courseId);
    }

    // `source` distinguishes a live "開始點名" session from a 匯入
    // (補登) one — otherwise indistinguishable in the session history
    // once both have an endedAt, since an import session is also
    // created already-ended. Required and exact-matched per shape below
    // so it can't be forged into the other shape's meaning.
    function isValidLiveSessionCreate() {
      return request.resource.data.createdAt == request.time &&
        request.resource.data.endedAt == null &&
        request.resource.data.source == 'live';
    }

    // 匯入點名記錄 (補登): a teacher backfilling a past day's attendance
    // creates a session that's pre-dated and already ended, instead of
    // the live "開始點名" flow's request.time/null pair. createdAt is
    // set to noon local time on the chosen date, so a same-day import
    // submitted before noon would otherwise send a createdAt ahead of
    // request.time and be denied — the 1-day tolerance below allows
    // that while still rejecting a genuinely future date (tomorrow or
    // later). endedAt must equal createdAt exactly (no "created but
    // still open" state for an import session).
    function isValidImportSessionCreate() {
      return request.resource.data.createdAt is timestamp &&
        request.resource.data.createdAt <= request.time + duration.value(1, 'd') &&
        request.resource.data.endedAt == request.resource.data.createdAt &&
        request.resource.data.source == 'import';
    }

    match /sessions/{sessionId} {
      allow create: if isTeacherOfCourse(request.resource.data.courseId) &&
        request.resource.data.createdBy == request.auth.token.email &&
        (isValidLiveSessionCreate() || isValidImportSessionCreate());
      // Listing (querying) sessions stays teacher-only. A course's
      // teacher or an enrolled student may fetch one session by its
      // exact id — needed by the student check-in flow to read
      // endedAt/courseId. `resource != null` guards the get-of-a-
      // nonexistent-id case (a garbage/tampered check-in link) so that
      // cleanly evaluates to a deny instead of erroring on
      // resource.data being unset.
      allow list: if isTeacherOfCourse(resource.data.courseId);
      allow get: if resource != null &&
        (isTeacherOfCourse(resource.data.courseId) || isEnrolledStudent(resource.data.courseId));
      // "結束點名": only the course's teachers, only a one-way
      // null -> request.time transition (no re-ending, no un-ending,
      // no backdating), and nothing else about the session may change.
      allow update: if isTeacherOfCourse(resource.data.courseId) &&
        resource.data.endedAt == null &&
        request.resource.data.endedAt == request.time &&
        request.resource.data.courseId == resource.data.courseId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.get('source', 'live') == resource.data.get('source', 'live') &&
        request.resource.data.keys().hasOnly(['courseId', 'createdBy', 'createdAt', 'endedAt', 'source']);
      // 刪除課程 (deleteCourse) deletes every session belonging to it —
      // done while the course document still exists, so this can still
      // prove isTeacherOfCourse.
      allow delete: if isTeacherOfCourse(resource.data.courseId);

      match /tokens/{tokenId} {
        function sessionCourseId() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)).data.courseId;
        }

        allow create: if isTeacherOfCourse(sessionCourseId()) &&
          request.resource.data.createdAt == request.time;
        allow read: if isTeacherOfCourse(sessionCourseId());
        // 刪除課程 deletes each session's tokens first, while the
        // session (and its course) still exist.
        allow delete: if isTeacherOfCourse(sessionCourseId());
      }
    }

    function isValidAttendanceDocId(attendanceId, data) {
      return attendanceId == data.sessionId + '_' + data.studentEmail;
    }

    // A student checking themselves in: status is always 'present', the
    // token must still be fresh, and studentEmail must be the requester.
    function isValidStudentAttendanceCreate(attendanceId) {
      let data = request.resource.data;
      let session = get(/databases/$(database)/documents/sessions/$(data.sessionId)).data;
      let course = get(/databases/$(database)/documents/courses/$(data.courseId)).data;
      let token = get(/databases/$(database)/documents/sessions/$(data.sessionId)/tokens/$(data.tokenId)).data;

      return isSignedIn() &&
        isValidAttendanceDocId(attendanceId, data) &&
        data.keys().hasOnly(['sessionId', 'courseId', 'studentEmail', 'tokenId', 'status', 'timestamp']) &&
        data.studentEmail == authEmail() &&
        data.status == 'present' &&
        data.timestamp == request.time &&
        data.courseId == session.courseId &&
        session.endedAt == null &&
        exists(/databases/$(database)/documents/courses/$(data.courseId)/roster/$(data.studentEmail)) &&
        token.createdAt > request.time - duration.value(course.qrExpirySeconds, 's');
    }

    // 'present' and 'absent' are fixed system statuses (self-check-in
    // and endSession's batch-absent pass write them literally) and are
    // always valid regardless of a course's custom status list. Every
    // other status must be one of that course's own customStatuses —
    // see isValidCustomStatuses for how that field is validated.
    function isValidAttendanceStatus(courseId, status) {
      return status == 'present' || status == 'absent' ||
        status in get(/databases/$(database)/documents/courses/$(courseId)).data.get('customStatuses', []);
    }

    // A teacher writing on a student's behalf: 補登 (add a record for a
    // student who has none) and endSession's batch-absent pass both go
    // through this. timestamp isn't pinned to request.time (manual
    // edits may backdate, per spec) but must at least be a real
    // Timestamp, not absent or malformed.
    function isValidTeacherAttendanceCreate(attendanceId) {
      let data = request.resource.data;

      return isTeacherOfCourse(data.courseId) &&
        isValidAttendanceDocId(attendanceId, data) &&
        data.keys().hasOnly(['sessionId', 'courseId', 'studentEmail', 'status', 'timestamp']) &&
        isValidAttendanceStatus(data.courseId, data.status) &&
        data.timestamp is timestamp &&
        get(/databases/$(database)/documents/sessions/$(data.sessionId)).data.courseId == data.courseId &&
        exists(/databases/$(database)/documents/courses/$(data.courseId)/roster/$(data.studentEmail));
    }

    // 更正狀態: a teacher may change status (and/or timestamp) on any
    // record for their course — including one a student self-authored
    // via check-in — but not the fields identifying which session/
    // student/token it's about, and not smuggle in new fields. A plain
    // (non-merge) setDoc that lands on a doc that already exists is an
    // update too, so this must also reject one that drops or changes
    // tokenId — otherwise a stale-read 補登 could silently overwrite
    // and erase a student's real self-check-in.
    function isValidAttendanceStatusUpdate() {
      let data = request.resource.data;

      return isTeacherOfCourse(resource.data.courseId) &&
        isValidAttendanceStatus(resource.data.courseId, data.status) &&
        data.timestamp is timestamp &&
        data.sessionId == resource.data.sessionId &&
        data.courseId == resource.data.courseId &&
        data.studentEmail == resource.data.studentEmail &&
        ('tokenId' in resource.data
          ? ('tokenId' in data && data.tokenId == resource.data.tokenId)
          : !('tokenId' in data)) &&
        data.keys().hasOnly(['sessionId', 'courseId', 'studentEmail', 'tokenId', 'status', 'timestamp']);
    }

    match /attendance/{attendanceId} {
      // A student may read only their own attendance records (this
      // also covers the "did I already check in" query used before
      // writing, and doubles as the seam #9's self-check page reads).
      // A course's teacher may read every attendance record for it —
      // needed to compute "who's missing" when ending a session, and
      // backs #8/#10's UI too. For `list` requests, Firestore's rule
      // provability only accepts get()-based checks like
      // isTeacherOfCourse() when every field they (transitively) read
      // from resource.data is also constrained by an equality filter
      // in the query — courseId here, always paired with a sessionId
      // filter by every caller in this codebase.
      allow read: if isSignedIn() && authEmail() == resource.data.studentEmail;
      allow read: if isTeacherOfCourse(resource.data.courseId);
      allow create: if isValidStudentAttendanceCreate(attendanceId) || isValidTeacherAttendanceCreate(attendanceId);
      // 更正狀態 / 刪除 (issue #8): only the course's teachers, on any
      // record for their course regardless of who originally wrote it.
      allow update: if isValidAttendanceStatusUpdate();
      allow delete: if isTeacherOfCourse(resource.data.courseId);
    }

    // A signed-in user may check only their own whitelist entry (by
    // path segment, so this is well-defined even when no such document
    // exists) — never list the whole collection. Compared against the
    // raw (not lowercased) token email to match isWhitelistedTeacher()
    // above, since teachers/{email} doc ids are Console-managed by
    // hand, not normalized like roster/attendance docs are.
    match /teachers/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
